{
  "name": "chess-topper-mobile",
  "version": "1.0.1",
  "private": true,
  "description": "Android-only Chess Topper mobile app with floating training overlay and quick settings.",
  "author": "Official Knightly",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "android:sync": "npm run build && npm run android:setup && cap sync android",
    "android:open": "cap open android",
    "android:build": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "android:setup": "node scripts/setup-android.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/preferences": "^8.0.0",
    "@fontsource/instrument-sans": "5.2.8",
    "chess.js": "1.4.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "10.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "6.3.5"
  }
}
